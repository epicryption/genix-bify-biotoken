terraform {
  required_version = ">= 1.6.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = var.bootstrap_region
}

variable "bootstrap_region" {
  type    = string
  default = "us-east-1"
}

variable "environment_names" {
  type    = list(string)
  default = ["us-east", "eu-west", "ap-se", "failover"]
}

resource "aws_kms_key" "tf_state_key" {
  description             = "KMS Key for Terraform State Buckets"
  deletion_window_in_days = 30
  enable_key_rotation     = true

  tags = {
    ManagedBy   = "OpenTofu"
    Environment = "Global-Bootstrap"
  }
}

resource "aws_kms_alias" "tf_state_key_alias" {
  name          = "alias/bify-tfstate-key"
  target_key_id = aws_kms_key.tf_state_key.key_id
}

resource "aws_s3_bucket" "tf_state" {
  bucket        = "bify-tfstate-prod"
  force_destroy = false

  lifecycle {
    prevent_destroy = true
  }

  tags = {
    ManagedBy   = "OpenTofu"
    Environment = "Global-Bootstrap"
  }
}

resource "aws_s3_bucket_versioning" "tf_state_versioning" {
  bucket = aws_s3_bucket.tf_state.id
  versioning_configuration {
    status = "Enabled"
  }
}

resource "aws_s3_bucket_server_side_encryption_configuration" "tf_state_encryption" {
  bucket = aws_s3_bucket.tf_state.id

  rule {
    apply_server_side_encryption_by_default {
      kms_master_key_id = aws_kms_key.tf_state_key.arn
      sse_algorithm     = "aws:kms"
    }
  }
}

resource "aws_s3_bucket_public_access_block" "tf_state_public_block" {
  bucket                  = aws_s3_bucket.tf_state.id
  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

resource "aws_dynamodb_table" "tf_locks" {
  name         = "bify-tflock"
  billing_mode = "PAY_PER_REQUEST"
  hash_key     = "LockID"

  attribute {
    name = "LockID"
    type = "S"
  }

  point_in_time_recovery {
    enabled = true
  }

  server_side_encryption {
    enabled     = true
    kms_key_arn = aws_kms_key.tf_state_key.arn
  }

  tags = {
    ManagedBy   = "OpenTofu"
    Environment = "Global-Bootstrap"
  }
}

output "s3_bucket_name" {
  value = aws_s3_bucket.tf_state.id
}

output "dynamodb_table_name" {
  value = aws_dynamodb_table.tf_locks.id
}

output "kms_key_arn" {
  value = aws_kms_key.tf_state_key.arn
}
